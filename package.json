{
  "name": "content-radar",
  "version": "2.0.0",
  "type": "module",
  "description": "Content Radar — scans technology content, summarizes it with AI, and posts to social channels.",
  "scripts": {
    "start": "node src/adapters/node.js run",
    "start:cron": "node src/adapters/node.js cron",
    "preview": "node src/adapters/node.js preview",
    "dev": "wrangler dev --config wrangler.toml",
    "deploy:cf": "wrangler deploy --config wrangler.toml",
    "docker:build": "docker build -t news-engine .",
    "docker:run": "docker compose up -d",
    "dashboard": "node src/dashboard/server.js",
    "dashboard:dev": "node --watch src/dashboard/server.js",
    "app": "node src/app/server.js",
    "app:dev": "node --watch src/app/server.js",
    "dev:token": "node scripts/dev-access-token.mjs",
    "test": "npm run test:node && npm run test:workers",
    "test:node": "node tests/run-node-tests.js",
    "test:workers": "vitest run --config vitest.config.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "node-cron": "^4.6.0"
  },
  "optionalDependencies": {
    "dotenv": "^16.4.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "vitest": "4.1.10",
    "wrangler": "4.112.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
