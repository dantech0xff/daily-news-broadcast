# === Runtime mode ===
# Cloudflare Worker runtime:
#   quiesced  -> no mutations
#   bootstrap -> health/status/queue plus operator pause; preview/provider work stays blocked
#   active    -> full delivery surface
NEWS_RUNTIME_MODE=bootstrap
NEWS_DEFAULT_PAUSED=true
TOKEN_MAINTENANCE_MODE=disabled

# === AI provider selection ===
# Supported: claude, openai, groq, gemini, qwen, deepseek, ollama, openrouter, together, custom, none
AI_PROVIDER=claude
AI_MODEL=

# === AI API keys ===
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
QWEN_API_KEY=your-qwen-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
TOGETHER_API_KEY=your-together-api-key

# === Local or custom AI ===
OLLAMA_BASE_URL=http://localhost:11434/v1
CUSTOM_AI_API_KEY=your-custom-ai-key
CUSTOM_AI_BASE_URL=https://example.com/v1
CUSTOM_AI_MODEL=your-custom-model
CUSTOM_AI_NAME=Custom AI

# === Telegram ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# === Optional output credentials ===
X_CLIENT_ID=your-x-client-id
X_DESTINATION_ID=your-non-secret-x-account-id
TOKEN_ENCRYPTION_KEY=your-token-encryption-key
FB_PAGE_TOKEN=your-facebook-page-token
FB_PAGE_ID=your-facebook-page-id
THREADS_USER_ID=your-threads-user-id

# === Cache and delivery store ===
CACHE_TYPE=file
CACHE_PATH=./.cache/news.json
REDIS_URL=redis://localhost:6379
DELIVERY_STORE_TYPE=file
DELIVERY_STORE_PATH=./.cache/delivery-state.json

# === Schedule and tuning ===
CRON_SCHEDULE=0 7 * * *
CRON_TIMEZONE=UTC
BROADCAST_MODE=drip
MAX_ARTICLES=18
MAX_ARTICLES_PER_SOURCE=3
CONCURRENCY_LIMIT=5
DRIP_BATCH_SIZE=5
DRIP_DELAY_MS=0
DELIVERY_ATTEMPT_TIMEOUT_MS=30000
COORDINATOR_REQUEST_TIMEOUT_MS=600000

# === Cloudflare manual trigger and operator recovery ===
TRIGGER_SECRET=your-trigger-secret
OPERATOR_SECRET=your-operator-secret
OPERATOR_KEY_ID=operator-main

# === Dashboard ===
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_EXTERNAL_ORIGIN=http://127.0.0.1:3000
DASHBOARD_TRIGGER_USERNAME=trigger
DASHBOARD_TRIGGER_PASSWORD=your-dashboard-trigger-password
DASHBOARD_OPERATOR_USERNAME=operator
DASHBOARD_OPERATOR_PASSWORD=your-dashboard-operator-password
DASHBOARD_TLS_CERT_PATH=
DASHBOARD_TLS_KEY_PATH=
DASHBOARD_TRUSTED_PROXIES=
